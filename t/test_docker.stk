## t/test_docker.stk — assertion tests for the stryke `Docker` package.
##
## Uses stryke's native test framework (`assert_*` + `test_run`).
## Requires the cdylib to be loaded — install once with `s pkg install -g .`
## so stryke's FFI bridge dlopens `lib/libstryke_docker.{dylib,so}` on
## `use Docker`. Pulls busybox:latest and exercises run/exec/network/volume
## when a Docker daemon is reachable.

use Docker

# ── permission-free: cdylib reachable ───────────────────────────────
val $pkg_version = Docker::pkg_version()
assert_ok $pkg_version, "Docker::pkg_version returns truthy (cdylib loaded)"

# ── daemon liveness ─────────────────────────────────────────────────
val $alive = eval { Docker::ping() }

if ($alive) {
    val $name = "stryke-test-$$"
    val $vol  = "stryke-test-vol-$$"
    val $net  = "stryke-test-net-$$"

    # version
    val $v = Docker::version()
    assert_ok defined $v->{Version}, "version returns Version field"

    # pull busybox (silent, drains stream)
    val @pull = Docker::pull("busybox:latest")
    assert_gt scalar(@pull), 0, "pull busybox emits events"

    # run busybox sleep — detached so we can exec into it
    val $r = Docker::run("busybox:latest",
        name    => $name,
        cmd     => ["sh", "-c", "sleep 30"],
        label   => ["stryke.test=1"],
        detach  => 1)
    assert_ok defined $r->{id}, "run returns container id"

    # ps filtered by our label includes our container
    val @ps = Docker::ps(all => 1, filters => { label => ["stryke.test=1"] })
    val $found_ps = grep { $_->{Names} && (grep { $_ =~ /\Q$name\E/ } @{$_->{Names}}) } @ps
    assert_ok $found_ps, "ps filter finds our container by label"

    # inspect returns running state
    val $info = Docker::inspect($name)
    assert_ok $info->{State}{Running}, "inspect: container is Running"

    # exec echoes stdin → stdout
    var @chunks
    Docker::exec $name, ["sh", "-c", "echo hello-stryke && echo err-line 1>&2"],
        callback => sub ($stream, $data) { push @chunks, [$stream, $data] }
    val $saw_stdout = grep { $_->[0] eq "stdout" && $_->[1] =~ /hello-stryke/ } @chunks
    assert_ok $saw_stdout, "exec emits hello-stryke on stdout"

    # network create
    val $nc = Docker::network_create($net, driver => "bridge")
    assert_ok defined $nc->{Id}, "network_create returns Id"

    # volume create
    val $vc = Docker::volume_create($vol)
    assert_eq $vc->{Name}, $vol, "volume_create returns Name"

    # cleanup
    Docker::rm $name, force => 1
    Docker::network_rm $net
    Docker::volume_rm $vol
    assert_ok 1, "cleanup (rm + network_rm + volume_rm) completed"
}

# ── pure helpers (no daemon — always run) ────────────────────────────
# `\@` escapes the at-sign so stryke does not array-interpolate the digest.
val $r = Docker::parse_image_ref("registry.example.com:5000/team/app:1.2.3\@sha256:abc123")
assert_eq $r->{registry},   "registry.example.com:5000", "parse_image_ref: registry"
assert_eq $r->{namespace},  "team",                      "parse_image_ref: namespace"
assert_eq $r->{repository}, "app",                       "parse_image_ref: repository"
assert_eq $r->{tag},        "1.2.3",                     "parse_image_ref: tag"
assert_eq $r->{digest},     "sha256:abc123",             "parse_image_ref: digest"

val $short = Docker::parse_image_ref("nginx")
assert_eq $short->{tag}, "latest", "parse_image_ref: short form defaults to latest"
assert_ok !defined($short->{registry}), "parse_image_ref: no registry for short form"

# normalize_image_ref: expand to Docker's canonical form.
assert_eq Docker::normalize_image_ref("nginx")->{ref},          "docker.io/library/nginx:latest", "normalize_image_ref: short name → registry+library+latest"
assert_eq Docker::normalize_image_ref("redis:6")->{ref},        "docker.io/library/redis:6",      "normalize_image_ref: keeps explicit tag"
assert_eq Docker::normalize_image_ref("myuser/app")->{ref},     "docker.io/myuser/app:latest",    "normalize_image_ref: user namespace kept"
assert_eq Docker::normalize_image_ref("ghcr.io/o/app")->{ref},  "ghcr.io/o/app:latest",           "normalize_image_ref: third-party registry, no library"
assert_eq Docker::normalize_image_ref("nginx")->{namespace},    "library",                        "normalize_image_ref: library namespace reported"

# build_image_ref: inverse of parse_image_ref (\@ escapes the literal @).
assert_eq Docker::build_image_ref(registry => "registry.example.com:5000", namespace => "team", repository => "app", tag => "1.2.3", digest => "sha256:abc123"), "registry.example.com:5000/team/app:1.2.3\@sha256:abc123", "build_image_ref: full ref"
assert_eq Docker::build_image_ref(repository => "nginx"), "nginx", "build_image_ref: bare repository"
assert_eq Docker::build_image_ref(namespace => "library", repository => "nginx", tag => "1.25"), "library/nginx:1.25", "build_image_ref: namespace + tag"
assert_dies fn { Docker::build_image_ref(tag => "x") }, "build_image_ref: missing repository errors"

assert_eq Docker::valid_container_name("web-1.api_v2"), 1, "valid_container_name: legal"
assert_eq Docker::valid_container_name("_bad"), 0,         "valid_container_name: leading underscore rejected"
assert_eq Docker::valid_container_name("has space"), 0,    "valid_container_name: space rejected"

# valid_image_tag: docker tag rules.
assert_ok Docker::valid_image_tag("v1.2.3")->{valid},        "valid_image_tag: dotted version"
assert_ok Docker::valid_image_tag("RELEASE_2025")->{valid},  "valid_image_tag: uppercase + underscore allowed"
assert_ok Docker::valid_image_tag("_lead")->{valid},         "valid_image_tag: underscore may lead"
assert_eq Docker::valid_image_tag(".dotstart")->{valid}, 0,  "valid_image_tag: may not start with a period"
assert_eq Docker::valid_image_tag("-dashstart")->{valid}, 0, "valid_image_tag: may not start with a dash"
assert_eq Docker::valid_image_tag("a/b")->{valid}, 0,        "valid_image_tag: slash rejected"
val $lt = Docker::valid_image_tag("a" x 129)
assert_eq $lt->{valid}, 0,                                   "valid_image_tag: over 128 chars fails"
assert_match qr/128/, $lt->{reason},                         "valid_image_tag: reason names the limit"

# valid_digest: OCI/distribution content-digest grammar.
val $dg = Docker::valid_digest("sha256:" . ("a" x 64))
assert_ok $dg->{valid},                                      "valid_digest: sha256 with 64 hex is valid"
assert_eq $dg->{algorithm}, "sha256",                        "valid_digest: algorithm split out"
assert_ok Docker::valid_digest("sha512:" . ("f" x 128))->{valid}, "valid_digest: sha512 with 128 hex"
assert_eq Docker::valid_digest("sha256:" . ("a" x 64) . "extra")->{valid}, 0, "valid_digest: sha256 must be exactly 64 hex"
assert_eq Docker::valid_digest("sha256:ABCDEF")->{valid}, 0, "valid_digest: rejects uppercase hex"
assert_eq Docker::valid_digest("deadbeef")->{valid}, 0,      "valid_digest: requires algorithm:hex form"

# valid_repository_name: distribution/reference path grammar (lowercase only).
assert_ok Docker::valid_repository_name("library/nginx")->{valid}, "valid_repository_name: namespaced path"
assert_ok Docker::valid_repository_name("a__b-c.d")->{valid},      "valid_repository_name: allowed separators"
assert_eq Docker::valid_repository_name("MyApp")->{valid}, 0,      "valid_repository_name: rejects uppercase (docker build -t MyApp)"
assert_eq Docker::valid_repository_name("a..b")->{valid}, 0,       "valid_repository_name: rejects double period"
assert_eq Docker::valid_repository_name("a//b")->{valid}, 0,       "valid_repository_name: rejects empty path component"
assert_dies fn { Docker::valid_repository_name() }, "valid_repository_name: dies on missing name"

# valid_image_ref: validate a complete reference (registry/ns/repo:tag@digest).
assert_ok Docker::valid_image_ref("nginx:1.25")->{valid},                         "valid_image_ref: repo + tag"
assert_ok Docker::valid_image_ref("registry.io:5000/ns/repo:tag")->{valid},       "valid_image_ref: registry with port + namespace"
assert_ok Docker::valid_image_ref("nginx\@sha256:" . ("0" x 64))->{valid},         "valid_image_ref: repo + digest"
val $bad = Docker::valid_image_ref("MyApp:latest")
assert_eq $bad->{valid}, 0,                          "valid_image_ref: uppercase repository rejected"
assert_match qr/^repository:/, $bad->{reason},       "valid_image_ref: reason names the failing component"
assert_eq Docker::valid_image_ref("nginx:-bad")->{valid}, 0,                       "valid_image_ref: a bad tag is rejected"
assert_dies fn { Docker::valid_image_ref() }, "valid_image_ref: dies on missing ref"

val $p = Docker::parse_port_spec("127.0.0.1:8080:80/tcp")
assert_eq $p->{host_ip},        "127.0.0.1", "parse_port_spec: host_ip"
assert_eq $p->{host_port},      "8080",      "parse_port_spec: host_port"
assert_eq $p->{container_port}, "80",        "parse_port_spec: container_port"
assert_eq $p->{protocol},       "tcp",       "parse_port_spec: protocol"
assert_eq Docker::parse_port_spec("53/udp")->{protocol}, "udp", "parse_port_spec: udp default-less"

# build_port_spec: inverse of parse_port_spec.
assert_eq Docker::build_port_spec(host_ip => "127.0.0.1", host_port => 8080, container_port => 80), "127.0.0.1:8080:80", "build_port_spec: ip:host:container"
assert_eq Docker::build_port_spec(host_port => 8080, container_port => 80), "8080:80", "build_port_spec: host:container"
assert_eq Docker::build_port_spec(container_port => 80), "80", "build_port_spec: container only"
assert_eq Docker::build_port_spec(host_port => 53, container_port => 53, protocol => "udp"), "53:53/udp", "build_port_spec: non-tcp appends /proto"
assert_eq Docker::parse_port_spec(Docker::build_port_spec(host_ip => "127.0.0.1", host_port => 8080, container_port => 80))->{host_port}, "8080", "build_port_spec → parse_port_spec round-trips"

# parse_ulimit: docker run --ulimit type=soft[:hard].
val $ul = Docker::parse_ulimit("nofile=1024:2048")
assert_eq $ul->{name}, "nofile", "parse_ulimit: rlimit type"
assert_eq $ul->{soft}, 1024,     "parse_ulimit: soft limit"
assert_eq $ul->{hard}, 2048,     "parse_ulimit: hard limit"
assert_eq $ul->{unlimited}, 0,   "parse_ulimit: bounded is not unlimited"
val $single = Docker::parse_ulimit("nproc=512")
assert_eq $single->{hard}, 512,  "parse_ulimit: single value sets hard = soft"
assert_eq Docker::parse_ulimit("core=-1:-1")->{unlimited}, 1, "parse_ulimit: -1 means unlimited"
assert_dies fn { Docker::parse_ulimit("nofile") }, "parse_ulimit: rejects a spec with no '='"
assert_dies fn { Docker::parse_ulimit("nofile=soft") }, "parse_ulimit: rejects a non-integer limit"

# parse_mount: bind (host path) read-only, named volume, anonymous.
val $bind = Docker::parse_mount("/data:/var/lib/data:ro")
assert_eq $bind->{type},     "bind",          "parse_mount: host path is a bind"
assert_eq $bind->{source},   "/data",         "parse_mount: bind source"
assert_eq $bind->{target},   "/var/lib/data", "parse_mount: bind target"
assert_eq $bind->{readonly}, 1,               "parse_mount: ro sets readonly"
val $vol = Docker::parse_mount("pgdata:/var/lib/postgresql/data")
assert_eq $vol->{type},     "volume", "parse_mount: named source is a volume"
assert_eq $vol->{readonly}, 0,        "parse_mount: defaults read-write"
val $anon = Docker::parse_mount("/cache")
assert_eq $anon->{type},   "anonymous", "parse_mount: lone path is anonymous"
assert_ok !defined($anon->{source}),    "parse_mount: anonymous has no source"

# build_mount: inverse of parse_mount.
assert_eq Docker::build_mount(source => "/data", target => "/var/lib/data", readonly => 1), "/data:/var/lib/data:ro", "build_mount: bind read-only"
assert_eq Docker::build_mount(source => "pgdata", target => "/app"), "pgdata:/app", "build_mount: named volume"
assert_eq Docker::build_mount(target => "/cache"), "/cache", "build_mount: anonymous volume (target only)"
assert_eq Docker::build_mount(source => "./src", target => "/app", options => ["ro", "z"]), "./src:/app:ro,z", "build_mount: option list"
# round-trips parse_mount.
assert_eq Docker::build_mount(%{ Docker::parse_mount("/data:/var/lib/data:ro") }), "/data:/var/lib/data:ro", "build_mount: round-trips parse_mount"
assert_dies fn { Docker::build_mount(target => "/cache", readonly => 1) }, "build_mount: options without a source error"

# parse_env: split on first =, host-passthrough for a bare key.
val $kv = Docker::parse_env("FOO=bar")
assert_eq $kv->{key},       "FOO", "parse_env: key before the ="
assert_eq $kv->{value},     "bar", "parse_env: value after the ="
assert_eq $kv->{from_host}, 0,     "parse_env: KEY=VALUE is not host passthrough"
assert_eq Docker::parse_env("URL=a=b=c")->{value}, "a=b=c", "parse_env: only the first = splits"
val $empty = Docker::parse_env("EMPTY=")
assert_eq $empty->{value},     "", "parse_env: trailing = is an empty value"
assert_eq $empty->{from_host}, 0,  "parse_env: empty value is still not passthrough"
val $host = Docker::parse_env("HOME")
assert_ok !defined($host->{value}), "parse_env: bare key has no value"
assert_eq $host->{from_host}, 1,    "parse_env: bare key is host passthrough"
assert_dies fn { Docker::parse_env("=oops") }, "parse_env: empty key errors"

# build_env: inverse of parse_env.
assert_eq Docker::build_env("FOO", "bar"), "FOO=bar", "build_env: KEY=VALUE"
assert_eq Docker::build_env("EMPTY", ""),  "EMPTY=",  "build_env: empty value gives trailing ="
assert_eq Docker::build_env("HOME"),       "HOME",    "build_env: no value is a bare key"
assert_eq Docker::build_env("PORT", 8080), "PORT=8080", "build_env: numeric value stringified"
# round-trips parse_env for every form.
for val $spec (qw(FOO=bar URL=a=b=c EMPTY= HOME)) {
    val $p = Docker::parse_env($spec)
    assert_eq Docker::build_env($p->{key}, $p->{value}), $spec, "build_env: round-trips $spec"
}
assert_dies fn { Docker::build_env("") }, "build_env: empty key errors"

# parse_restart_policy: the four --restart policies.
assert_eq Docker::parse_restart_policy("always")->{policy}, "always", "parse_restart_policy: always"
assert_ok !defined(Docker::parse_restart_policy("no")->{max_retries}), "parse_restart_policy: no has no retry count"
val $of = Docker::parse_restart_policy("on-failure:5")
assert_eq $of->{policy}, "on-failure", "parse_restart_policy: on-failure policy"
assert_eq $of->{max_retries}, 5,        "parse_restart_policy: on-failure:5 retry count"
assert_dies fn { Docker::parse_restart_policy("always:3") }, "parse_restart_policy: count on a non-on-failure policy dies"
assert_dies fn { Docker::parse_restart_policy("sometimes") }, "parse_restart_policy: unknown policy dies"

# build_restart_policy: inverse.
assert_eq Docker::build_restart_policy("unless-stopped"), "unless-stopped", "build_restart_policy: bare policy"
assert_eq Docker::build_restart_policy("on-failure", 10), "on-failure:10", "build_restart_policy: on-failure with count"
# round-trips parse_restart_policy.
for val $spec (qw(no always unless-stopped on-failure on-failure:5)) {
    val $r = Docker::parse_restart_policy($spec)
    assert_eq Docker::build_restart_policy($r->{policy}, $r->{max_retries}), $spec, "build_restart_policy: round-trips $spec"
}
assert_dies fn { Docker::build_restart_policy("always", 3) }, "build_restart_policy: count on a non-on-failure policy dies"

# parse_memory: go-units RAMInBytes (base 1024, k/m/g/t/p, optional i/b, decimals).
assert_eq Docker::parse_memory("512m")->{bytes},   536870912,  "parse_memory: 512m = 512 MiB"
assert_eq Docker::parse_memory("2g")->{bytes},     2147483648, "parse_memory: 2g = 2 GiB"
assert_eq Docker::parse_memory("512mib")->{bytes}, 536870912,  "parse_memory: the ib decoration is the same binary unit"
assert_eq Docker::parse_memory("1048576")->{bytes}, 1048576,   "parse_memory: a bare number is bytes"
assert_eq Docker::parse_memory("1.5g")->{bytes},   1610612736, "parse_memory: decimals truncate toward zero"
assert_eq Docker::parse_memory("2g")->{unit},      "g",        "parse_memory: surfaces the unit letter"
assert_dies fn { Docker::parse_memory("12x") },  "parse_memory: unknown suffix dies"
assert_dies fn { Docker::parse_memory("abc") },  "parse_memory: a non-numeric value dies"

# format_memory: inverse of parse_memory (bytes → largest exact binary unit).
assert_eq Docker::format_memory(536870912)->{memory},  "512m", "format_memory: 512 MiB → 512m"
assert_eq Docker::format_memory(2147483648)->{memory}, "2g",   "format_memory: 2 GiB → 2g"
assert_eq Docker::format_memory(1610612736)->{memory}, "1536m", "format_memory: 1.5 GiB falls to 1536m (exact)"
assert_eq Docker::format_memory(100)->{memory},        "100",  "format_memory: not divisible by 1024 stays a byte count"
assert_eq Docker::format_memory(0)->{memory},          "0",    "format_memory: zero is 0"
assert_eq Docker::parse_memory(Docker::format_memory(536870912)->{memory})->{bytes}, 536870912, "format_memory: round-trips parse_memory"
assert_dies fn { Docker::format_memory(-1) }, "format_memory: rejects a negative byte count"

# parse_platform: --platform os/arch[/variant].
val $pl = Docker::parse_platform("linux/amd64")
assert_eq $pl->{os}, "linux",            "parse_platform: os"
assert_eq $pl->{architecture}, "amd64",  "parse_platform: architecture"
assert_ok !defined($pl->{variant}),      "parse_platform: no variant when omitted"
val $plv = Docker::parse_platform("linux/arm64/v8")
assert_eq $plv->{variant}, "v8",         "parse_platform: variant when present"
assert_dies fn { Docker::parse_platform("linux") },             "parse_platform: rejects a bare os"
assert_dies fn { Docker::parse_platform("linux/arm/v7/extra") }, "parse_platform: rejects too many segments"

# build_platform: inverse of parse_platform.
assert_eq Docker::build_platform(+{ os => "linux", architecture => "amd64" })->{platform}, "linux/amd64", "build_platform: two-part os/arch"
assert_eq Docker::build_platform(+{ os => "linux", architecture => "arm64", variant => "v8" })->{platform}, "linux/arm64/v8", "build_platform: three-part with variant"
val $pp = Docker::parse_platform("linux/arm64/v8")
assert_eq Docker::build_platform(+{ os => $pp->{os}, architecture => $pp->{architecture}, variant => $pp->{variant} })->{platform}, "linux/arm64/v8", "build_platform: round-trips parse_platform"
assert_dies fn { Docker::build_platform(+{ architecture => "amd64" }) },                            "build_platform: rejects a missing os"
assert_dies fn { Docker::build_platform(+{ os => "linux", architecture => "amd64", variant => "" }) }, "build_platform: rejects an empty variant"

# parse_label: --label KEY=VALUE; first = splits; bare key → undef value.
val $lbl = Docker::parse_label("com.example.app=web")
assert_eq $lbl->{key},   "com.example.app", "parse_label: key before the ="
assert_eq $lbl->{value}, "web",             "parse_label: value after the ="
assert_eq Docker::parse_label("url=a=b=c")->{value}, "a=b=c", "parse_label: only the first = splits"
assert_eq Docker::parse_label("empty=")->{value}, "", "parse_label: trailing = is an empty value"
assert_ok !defined(Docker::parse_label("bare")->{value}), "parse_label: bare key has undef value"
assert_dies fn { Docker::parse_label("=v") }, "parse_label: empty key errors"

# build_label: inverse of parse_label.
assert_eq Docker::build_label("app", "web"), "app=web", "build_label: KEY=VALUE"
assert_eq Docker::build_label("empty", ""),  "empty=",   "build_label: empty value gives trailing ="
assert_eq Docker::build_label("bare"),       "bare",     "build_label: no value is a bare key"
for val $spec (qw(app=web url=a=b=c empty= bare)) {
    val $p = Docker::parse_label($spec)
    assert_eq Docker::build_label($p->{key}, $p->{value}), $spec, "build_label: round-trips $spec"
}

# parse_device: --device host[:container[:perms]].
val $dev = Docker::parse_device("/dev/sda:/dev/xvda:rw")
assert_eq $dev->{host_path},      "/dev/sda",  "parse_device: host path"
assert_eq $dev->{container_path}, "/dev/xvda", "parse_device: container path"
assert_eq $dev->{permissions},    "rw",        "parse_device: permissions"
assert_eq Docker::parse_device("/dev/snd")->{container_path}, "/dev/snd", "parse_device: container defaults to host"
assert_eq Docker::parse_device("/dev/snd")->{permissions}, "rwm", "parse_device: perms default to rwm"
assert_dies fn { Docker::parse_device("/dev/sda:/dev/xvda:rx") }, "parse_device: rejects a bad perm char"

# build_device: inverse of parse_device (shortest round-tripping form).
assert_eq Docker::build_device(host_path => "/dev/snd"), "/dev/snd", "build_device: host only"
assert_eq Docker::build_device(host_path => "/dev/sda", container_path => "/dev/xvda"), "/dev/sda:/dev/xvda", "build_device: host:container"
assert_eq Docker::build_device(host_path => "/dev/sda", container_path => "/dev/xvda", permissions => "rw"), "/dev/sda:/dev/xvda:rw", "build_device: full form"
for val $spec (qw(/dev/snd)) {
    val $p = Docker::parse_device($spec)
    assert_eq Docker::build_device(host_path => $p->{host_path}, container_path => $p->{container_path}, permissions => $p->{permissions}), $spec, "build_device: round-trips $spec"
}

# parse_signal: normalize a name or number to the canonical SIG form.
assert_eq Docker::parse_signal(9)->{signal}, "SIGKILL", "parse_signal: number → SIGKILL"
assert_eq Docker::parse_signal(9)->{number}, 9,         "parse_signal: number preserved"
assert_eq Docker::parse_signal("KILL")->{signal}, "SIGKILL", "parse_signal: bare name → SIGKILL"
assert_eq Docker::parse_signal("sigterm")->{signal}, "SIGTERM", "parse_signal: lowercase prefixed name"
assert_eq Docker::parse_signal("KILL")->{number}, 9,    "parse_signal: name resolves the number"
assert_ok !defined(Docker::parse_signal(64)->{name}),  "parse_signal: unknown number has no name"
assert_dies fn { Docker::parse_signal("") }, "parse_signal: empty signal dies"

test_run
