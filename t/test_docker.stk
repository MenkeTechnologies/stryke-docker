## t/test_docker.stk — assertion tests for the stryke `Docker` package.
##
## Uses stryke's native test framework (`assert_*` + `test_run`).
## Requires the cdylib to be loaded — install once with `s pkg install -g .`
## so stryke's FFI bridge dlopens `lib/libstryke_docker.{dylib,so}` on
## `use Docker`. Pulls busybox:latest and exercises run/exec/network/volume
## when a Docker daemon is reachable.

use Docker

# ── permission-free: cdylib reachable ───────────────────────────────
val $pkg_version = Docker::pkg_version()
assert_ok $pkg_version, "Docker::pkg_version returns truthy (cdylib loaded)"

# ── daemon liveness ─────────────────────────────────────────────────
val $alive = eval { Docker::ping() }

if ($alive) {
    val $name = "stryke-test-$$"
    val $vol  = "stryke-test-vol-$$"
    val $net  = "stryke-test-net-$$"

    # version
    val $v = Docker::version()
    assert_ok defined $v->{Version}, "version returns Version field"

    # pull busybox (silent, drains stream)
    val @pull = Docker::pull("busybox:latest")
    assert_gt scalar(@pull), 0, "pull busybox emits events"

    # run busybox sleep — detached so we can exec into it
    val $r = Docker::run("busybox:latest",
        name    => $name,
        cmd     => ["sh", "-c", "sleep 30"],
        label   => ["stryke.test=1"],
        detach  => 1)
    assert_ok defined $r->{id}, "run returns container id"

    # ps filtered by our label includes our container
    val @ps = Docker::ps(all => 1, filters => { label => ["stryke.test=1"] })
    val $found_ps = grep { $_->{Names} && (grep { $_ =~ /\Q$name\E/ } @{$_->{Names}}) } @ps
    assert_ok $found_ps, "ps filter finds our container by label"

    # inspect returns running state
    val $info = Docker::inspect($name)
    assert_ok $info->{State}{Running}, "inspect: container is Running"

    # exec echoes stdin → stdout
    var @chunks
    Docker::exec $name, ["sh", "-c", "echo hello-stryke && echo err-line 1>&2"],
        callback => sub ($stream, $data) { push @chunks, [$stream, $data] }
    val $saw_stdout = grep { $_->[0] eq "stdout" && $_->[1] =~ /hello-stryke/ } @chunks
    assert_ok $saw_stdout, "exec emits hello-stryke on stdout"

    # network create
    val $nc = Docker::network_create($net, driver => "bridge")
    assert_ok defined $nc->{Id}, "network_create returns Id"

    # volume create
    val $vc = Docker::volume_create($vol)
    assert_eq $vc->{Name}, $vol, "volume_create returns Name"

    # cleanup
    Docker::rm $name, force => 1
    Docker::network_rm $net
    Docker::volume_rm $vol
    assert_ok 1, "cleanup (rm + network_rm + volume_rm) completed"
}

test_run
