## t/test_docker.stk — assertion tests for the stryke `Docker` package.
##
## Uses stryke's native test framework (`assert_*` + `test_run`).
## Requires the cdylib to be loaded — install once with `s pkg install -g .`
## so stryke's FFI bridge dlopens `lib/libstryke_docker.{dylib,so}` on
## `use Docker`. Pulls busybox:latest and exercises run/exec/network/volume
## when a Docker daemon is reachable.

use Docker

# ── permission-free: cdylib reachable ───────────────────────────────
val $pkg_version = Docker::pkg_version()
assert_ok $pkg_version, "Docker::pkg_version returns truthy (cdylib loaded)"

# ── daemon liveness ─────────────────────────────────────────────────
val $alive = eval { Docker::ping() }

if ($alive) {
    val $name = "stryke-test-$$"
    val $vol  = "stryke-test-vol-$$"
    val $net  = "stryke-test-net-$$"

    # version
    val $v = Docker::version()
    assert_ok defined $v->{Version}, "version returns Version field"

    # pull busybox (silent, drains stream)
    val @pull = Docker::pull("busybox:latest")
    assert_gt scalar(@pull), 0, "pull busybox emits events"

    # run busybox sleep — detached so we can exec into it
    val $r = Docker::run("busybox:latest",
        name    => $name,
        cmd     => ["sh", "-c", "sleep 30"],
        label   => ["stryke.test=1"],
        detach  => 1)
    assert_ok defined $r->{id}, "run returns container id"

    # ps filtered by our label includes our container
    val @ps = Docker::ps(all => 1, filters => { label => ["stryke.test=1"] })
    val $found_ps = grep { $_->{Names} && (grep { $_ =~ /\Q$name\E/ } @{$_->{Names}}) } @ps
    assert_ok $found_ps, "ps filter finds our container by label"

    # inspect returns running state
    val $info = Docker::inspect($name)
    assert_ok $info->{State}{Running}, "inspect: container is Running"

    # exec echoes stdin → stdout
    var @chunks
    Docker::exec $name, ["sh", "-c", "echo hello-stryke && echo err-line 1>&2"],
        callback => sub ($stream, $data) { push @chunks, [$stream, $data] }
    val $saw_stdout = grep { $_->[0] eq "stdout" && $_->[1] =~ /hello-stryke/ } @chunks
    assert_ok $saw_stdout, "exec emits hello-stryke on stdout"

    # network create
    val $nc = Docker::network_create($net, driver => "bridge")
    assert_ok defined $nc->{Id}, "network_create returns Id"

    # volume create
    val $vc = Docker::volume_create($vol)
    assert_eq $vc->{Name}, $vol, "volume_create returns Name"

    # cleanup
    Docker::rm $name, force => 1
    Docker::network_rm $net
    Docker::volume_rm $vol
    assert_ok 1, "cleanup (rm + network_rm + volume_rm) completed"
}

# ── pure helpers (no daemon — always run) ────────────────────────────
# `\@` escapes the at-sign so stryke does not array-interpolate the digest.
val $r = Docker::parse_image_ref("registry.example.com:5000/team/app:1.2.3\@sha256:abc123")
assert_eq $r->{registry},   "registry.example.com:5000", "parse_image_ref: registry"
assert_eq $r->{namespace},  "team",                      "parse_image_ref: namespace"
assert_eq $r->{repository}, "app",                       "parse_image_ref: repository"
assert_eq $r->{tag},        "1.2.3",                     "parse_image_ref: tag"
assert_eq $r->{digest},     "sha256:abc123",             "parse_image_ref: digest"

val $short = Docker::parse_image_ref("nginx")
assert_eq $short->{tag}, "latest", "parse_image_ref: short form defaults to latest"
assert_ok !defined($short->{registry}), "parse_image_ref: no registry for short form"

assert_eq Docker::valid_container_name("web-1.api_v2"), 1, "valid_container_name: legal"
assert_eq Docker::valid_container_name("_bad"), 0,         "valid_container_name: leading underscore rejected"
assert_eq Docker::valid_container_name("has space"), 0,    "valid_container_name: space rejected"

val $p = Docker::parse_port_spec("127.0.0.1:8080:80/tcp")
assert_eq $p->{host_ip},        "127.0.0.1", "parse_port_spec: host_ip"
assert_eq $p->{host_port},      "8080",      "parse_port_spec: host_port"
assert_eq $p->{container_port}, "80",        "parse_port_spec: container_port"
assert_eq $p->{protocol},       "tcp",       "parse_port_spec: protocol"
assert_eq Docker::parse_port_spec("53/udp")->{protocol}, "udp", "parse_port_spec: udp default-less"

# parse_mount: bind (host path) read-only, named volume, anonymous.
val $bind = Docker::parse_mount("/data:/var/lib/data:ro")
assert_eq $bind->{type},     "bind",          "parse_mount: host path is a bind"
assert_eq $bind->{source},   "/data",         "parse_mount: bind source"
assert_eq $bind->{target},   "/var/lib/data", "parse_mount: bind target"
assert_eq $bind->{readonly}, 1,               "parse_mount: ro sets readonly"
val $vol = Docker::parse_mount("pgdata:/var/lib/postgresql/data")
assert_eq $vol->{type},     "volume", "parse_mount: named source is a volume"
assert_eq $vol->{readonly}, 0,        "parse_mount: defaults read-write"
val $anon = Docker::parse_mount("/cache")
assert_eq $anon->{type},   "anonymous", "parse_mount: lone path is anonymous"
assert_ok !defined($anon->{source}),    "parse_mount: anonymous has no source"

test_run
