## lib/Docker.stk — Docker client for stryke (`use Docker`).
##
## Thin wrapper around the `stryke-docker` cdylib's `docker__*` exports.
## The cdylib is dlopened in-process on first `use Docker` (see stryke's
## `pkg/commands.rs::try_load_ffi_for`) and registers each export as a
## stryke-callable function via `rust_ffi::load_cdylib`.
##
## Replaces the v1 helper-binary model (fork(2) + exec(2) + fresh dockerd
## HTTP connection per call). The cdylib holds:
##   * one shared tokio runtime
##   * a bollard::Docker client cache keyed by DOCKER_HOST
## Back-to-back calls reuse the same client + underlying HTTP pool.
##
## v0.2.0 surface: the core 24 ops (containers, images, networks,
## volumes, exec, logs, prune). Streaming-only ops (events, stats,
## logs --follow, build, push) are deferred — they need a callback FFI
## shape that v1's `FfiSig::StrToStr` doesn't model.

package Docker

# ── error dispatch ────────────────────────────────────────────────────

## Decode the cdylib's JSON return; die on `{error}` payload.
fn Docker::_decode ($name, $json) {
    val $o = from_json $json
    if (ref $o eq "HASH" && exists $o->{error}) {
        die "Docker::$name: $o->{error}"
    }
    $o
}

## Build the FFI request hash by merging the caller's connection opts.
fn Docker::_req ($extra, $opts) {
    var %r = %$extra
    $r{host} = $opts->{host} if exists $opts->{host} && defined $opts->{host}
    \%r
}

# ── version + ping ──────────────────────────────────────────────────

## Return the package version string.
fn Docker::version (%opts) {
    Docker::_decode("version", docker__version(to_json(Docker::_req({}, \%opts))))
}

## Return the cdylib's `CARGO_PKG_VERSION` string.
fn Docker::pkg_version {
    Docker::_decode("pkg_version", docker__pkg_version("{}"))->{version}
}

## Connectivity probe — returns 1 on success, 0 on failure.
fn Docker::ping (%opts) {
    val $o = Docker::_decode("ping", docker__ping(to_json(Docker::_req({}, \%opts))))
    lc($o->{value} // "") eq "ok"
}

## dockerd info hash (storage driver, plugins, etc.).
fn Docker::info (%opts) {
    Docker::_decode("info", docker__info(to_json(Docker::_req({}, \%opts))))
}

# ── containers ───────────────────────────────────────────────────────

## List containers (running by default; pass `all => 1`).
fn Docker::ps (%opts) {
    val $r = Docker::_req({ all => ($opts{all} ? \1 : \0) }, \%opts)
    val $o = Docker::_decode("ps", docker__ps(to_json($r)))
    @{ $o->{containers} }
}

## Full inspect output for one container.
fn Docker::inspect ($container, %opts) {
    Docker::_decode("inspect",
        docker__inspect(to_json(Docker::_req({ container => $container }, \%opts))))
}

## Create then optionally start. Pass `start => 1` to start after create.
fn Docker::create ($image, %opts) {
    val $r = Docker::_req(
        { image => $image, name => $opts{name}, cmd => $opts{cmd}, env => $opts{env} },
        \%opts
    )
    val $created = Docker::_decode("create", docker__create(to_json($r)))
    if ($opts{start}) {
        Docker::start($created->{Id}, %opts)
    }
    $created
}

## Run: create + start in one shot.
fn Docker::run ($image, %opts) {
    $opts{start} = 1
    Docker::create($image, %opts)
}

## Start an existing container by name/id; returns 1 on success.
fn Docker::start ($container, %opts) {
    Docker::_decode("start",
        docker__start(to_json(Docker::_req({ container => $container }, \%opts))))->{ok} ? 1 : 0
}

## Stop a container (optional `timeout` seconds); returns 1 on success.
fn Docker::stop ($container, %opts) {
    Docker::_decode("stop",
        docker__stop(to_json(Docker::_req({ container => $container, timeout => $opts{timeout} }, \%opts))))->{ok} ? 1 : 0
}

## Restart a container; returns 1 on success.
fn Docker::restart ($container, %opts) {
    Docker::_decode("restart",
        docker__restart(to_json(Docker::_req({ container => $container }, \%opts))))->{ok} ? 1 : 0
}

## Send a signal (default SIGKILL) to a container; returns 1 on success.
fn Docker::kill ($container, %opts) {
    Docker::_decode("kill",
        docker__kill(to_json(Docker::_req({ container => $container, signal => $opts{signal} }, \%opts))))->{ok} ? 1 : 0
}

## Remove a container; opts: `force`, `volumes`. Returns 1 on success.
fn Docker::rm ($container, %opts) {
    val $r = Docker::_req(
        { container => $container,
          force => ($opts{force} ? \1 : \0),
          volumes => ($opts{volumes} ? \1 : \0) },
        \%opts
    )
    Docker::_decode("rm", docker__rm(to_json($r)))->{ok} ? 1 : 0
}

## Pause a running container. Returns 1 on success.
fn Docker::pause ($container, %opts) {
    Docker::_decode("pause", docker__pause(to_json(Docker::_req({ container => $container }, \%opts))))->{ok} ? 1 : 0
}

## Unpause a paused container. Returns 1 on success.
fn Docker::unpause ($container, %opts) {
    Docker::_decode("unpause", docker__unpause(to_json(Docker::_req({ container => $container }, \%opts))))->{ok} ? 1 : 0
}

## Rename $container to $name. Returns 1 on success.
fn Docker::rename ($container, $name, %opts) {
    Docker::_decode("rename",
        docker__rename(to_json(Docker::_req({ container => $container, name => $name }, \%opts))))->{ok} ? 1 : 0
}

## Block until $container exits; returns its exit status code.
fn Docker::wait ($container, %opts) {
    Docker::_decode("wait",
        docker__wait(to_json(Docker::_req({ container => $container }, \%opts))))->{status_code}
}

## Running processes inside $container (docker top). opts: ps_args (default
## the daemon's). Returns { Titles, Processes }.
fn Docker::top ($container, %opts) {
    Docker::_decode("top",
        docker__top(to_json(Docker::_req({ container => $container, ps_args => $opts{ps_args} }, \%opts))))
}

## Commit $container's state to a new image. opts: repo, tag (default latest),
## comment, author, pause (default true). Returns the new image id.
fn Docker::commit ($container, %opts) {
    val $r = Docker::_req(
        { container => $container, repo => $opts{repo}, tag => $opts{tag},
          comment => $opts{comment}, author => $opts{author},
          pause => (exists $opts{pause} ? ($opts{pause} ? \1 : \0) : \1) },
        \%opts
    )
    Docker::_decode("commit", docker__commit(to_json($r)))->{id}
}

# ── logs + exec ──────────────────────────────────────────────────────

## Snapshot logs of a container as a single string. `tail => N` to limit.
fn Docker::logs ($container, %opts) {
    val $r = Docker::_req({ container => $container, tail => $opts{tail} }, \%opts)
    Docker::_decode("logs", docker__logs(to_json($r)))->{logs}
}

## Logs-follow is a streaming op — deferred from v0.2.0 (needs a callback
## FFI shape). Fall back to `Docker::logs` for snapshot reads.
fn Docker::logs_follow ($container, %opts) {
    die "Docker::logs_follow: streaming ops are deferred in v0.2.0 cdylib — use `Docker::logs` for snapshot reads"
}

## Run $cmd (arrayref) inside container; returns captured stdout+stderr.
fn Docker::exec ($container, $cmd, %opts) {
    die "Docker::exec: cmd must be arrayref" unless ref($cmd) eq "ARRAY"
    val $r = Docker::_req({ container => $container, cmd => $cmd }, \%opts)
    Docker::_decode("exec", docker__exec(to_json($r)))->{output}
}

# ── images ──────────────────────────────────────────────────────────

## List images; `all => 1` includes intermediate layers.
fn Docker::images (%opts) {
    val $r = Docker::_req({ all => ($opts{all} ? \1 : \0) }, \%opts)
    val $o = Docker::_decode("images", docker__images(to_json($r)))
    @{ $o->{images} }
}

## Pull an image from its registry.
fn Docker::pull ($image, %opts) {
    Docker::_decode("pull",
        docker__pull(to_json(Docker::_req({ image => $image }, \%opts))))
}

## Push an image — deferred in v0.2.0 cdylib.
fn Docker::push ($image, %opts) {
    die "Docker::push: deferred in v0.2.0 cdylib (registry auth surface needs design)"
}

## Remove an image; opt `force`. Returns 1 on success.
fn Docker::rmi ($image, %opts) {
    val $r = Docker::_req({ image => $image, force => ($opts{force} ? \1 : \0) }, \%opts)
    Docker::_decode("rmi", docker__rmi(to_json($r)))->{ok} ? 1 : 0
}

## Tag $source as $target.
fn Docker::tag ($source, $target, %opts) {
    Docker::_decode("tag",
        docker__tag(to_json(Docker::_req({ source => $source, target => $target }, \%opts))))->{ok} ? 1 : 0
}

## Build an image — deferred in v0.2.0 cdylib.
fn Docker::build ($dir, %opts) {
    die "Docker::build: deferred in v0.2.0 cdylib (tar+stream surface needs design)"
}

# ── networks ────────────────────────────────────────────────────────

## List networks.
fn Docker::networks (%opts) {
    val $o = Docker::_decode("networks", docker__networks(to_json(Docker::_req({}, \%opts))))
    @{ $o->{networks} }
}

## Create a network. Opt `driver` (default `bridge`).
fn Docker::network_create ($name, %opts) {
    Docker::_decode("network_create",
        docker__network_create(to_json(Docker::_req({ name => $name, driver => $opts{driver} }, \%opts))))
}

## Remove a network by name; returns 1 on success.
fn Docker::network_rm ($name, %opts) {
    Docker::_decode("network_rm",
        docker__network_rm(to_json(Docker::_req({ name => $name }, \%opts))))->{ok} ? 1 : 0
}

# ── volumes ─────────────────────────────────────────────────────────

## List volumes.
fn Docker::volumes (%opts) {
    val $o = Docker::_decode("volumes", docker__volumes(to_json(Docker::_req({}, \%opts))))
    $o->{volumes}
}

## Create a volume by name.
fn Docker::volume_create ($name, %opts) {
    Docker::_decode("volume_create",
        docker__volume_create(to_json(Docker::_req({ name => $name }, \%opts))))
}

## Remove a volume; opt `force`. Returns 1 on success.
fn Docker::volume_rm ($name, %opts) {
    val $r = Docker::_req({ name => $name, force => ($opts{force} ? \1 : \0) }, \%opts)
    Docker::_decode("volume_rm", docker__volume_rm(to_json($r)))->{ok} ? 1 : 0
}

# ── prune ───────────────────────────────────────────────────────────

## Prune unused resources. `kind => containers|images|volumes|networks`.
fn Docker::prune (%opts) {
    val $kind = $opts{kind} // "containers"
    Docker::_decode("prune",
        docker__prune(to_json(Docker::_req({ kind => $kind }, \%opts))))
}

# ── deferred streaming ops ──────────────────────────────────────────

## Streaming events — deferred in v0.2.0 cdylib.
fn Docker::events (%opts) {
    die "Docker::events: streaming ops are deferred in v0.2.0 cdylib"
}

## One-shot resource-usage snapshot for $container (docker stats --no-stream).
## Returns the raw stats document (cpu_stats, memory_stats, networks, …).
## Continuous streaming stats remain deferred (needs a callback FFI shape).
fn Docker::stats ($container, %opts) {
    Docker::_decode("stats",
        docker__stats(to_json(Docker::_req({ container => $container }, \%opts))))
}

# ── inspection extras ────────────────────────────────────────────────

## Filesystem changes in $container vs its image. Each: { Path, Kind }
## (Kind 0 = modified, 1 = added, 2 = deleted).
fn Docker::diff ($container, %opts) {
    @{ Docker::_decode("diff",
        docker__diff(to_json(Docker::_req({ container => $container }, \%opts))))->{changes} }
}

## Build history (layers) of an $image. Each layer: { Id, Created, CreatedBy, Size, ... }.
fn Docker::history ($image, %opts) {
    @{ Docker::_decode("history",
        docker__history(to_json(Docker::_req({ image => $image }, \%opts))))->{history} }
}

## Disk usage (`docker system df`): images, containers, volumes, build cache.
fn Docker::df (%opts) {
    Docker::_decode("df", docker__df(to_json(Docker::_req({}, \%opts))))
}

## Port map of $container: { "80/tcp" => [{ HostIp, HostPort }], ... }.
fn Docker::port ($container, %opts) {
    Docker::_decode("port",
        docker__port(to_json(Docker::_req({ container => $container }, \%opts))))->{ports}
}

## Update a running $container's resource limits. opts: memory, memory_swap
## (bytes), cpu_shares, cpu_quota, cpu_period, cpuset_cpus. Only the supplied
## fields change.
fn Docker::update ($container, %opts) {
    val $r = Docker::_req(
        { container => $container, memory => $opts{memory}, memory_swap => $opts{memory_swap},
          cpu_shares => $opts{cpu_shares}, cpu_quota => $opts{cpu_quota},
          cpu_period => $opts{cpu_period}, cpuset_cpus => $opts{cpuset_cpus} },
        \%opts
    )
    Docker::_decode("update", docker__update(to_json($r)))
}

## Inspect an image — full config, layers, RootFS, history summary.
fn Docker::image_inspect ($image, %opts) {
    Docker::_decode("image_inspect",
        docker__image_inspect(to_json(Docker::_req({ image => $image }, \%opts))))
}

## Inspect a volume — driver, mountpoint, labels, options.
fn Docker::volume_inspect ($volume, %opts) {
    Docker::_decode("volume_inspect",
        docker__volume_inspect(to_json(Docker::_req({ volume => $volume }, \%opts))))
}

## Inspect a network — driver, subnet/gateway, connected containers.
fn Docker::network_inspect ($network, %opts) {
    Docker::_decode("network_inspect",
        docker__network_inspect(to_json(Docker::_req({ network => $network }, \%opts))))
}

# ── pure helpers (no daemon) ──────────────────────────────────────────

## Parse an image reference "[registry[:port]/]name[:tag][@digest]" into a
## hashref { registry, namespace, repository, tag, digest, path }. Tag defaults
## to "latest" unless a digest pins it. Contacts no registry.
fn Docker::parse_image_ref ($ref) {
    Docker::_decode("parse_image_ref", docker__parse_image_ref(to_json({ ref => $ref })))
}

## Assemble an image reference from parts — inverse of parse_image_ref. %opts:
## repository (required), registry, namespace, tag, digest. Produces
## "[registry/][namespace/]repository[:tag][@digest]". Returns the ref string.
fn Docker::build_image_ref (%opts) {
    Docker::_decode("build_image_ref", docker__build_image_ref(to_json(\%opts)))->{ref}
}

## True if $name is a valid Docker container/volume/network name
## (/?[a-zA-Z0-9][a-zA-Z0-9_.-]+).
fn Docker::valid_container_name ($name) {
    Docker::_decode("valid_container_name",
        docker__valid_container_name(to_json({ name => $name })))->{valid}
}

## Parse a -p port spec "[host_ip:][host_port:]container_port[/proto]" into a
## hashref { host_ip, host_port, container_port, protocol }. IPv6 hosts must be
## bracketed.
fn Docker::parse_port_spec ($spec) {
    Docker::_decode("parse_port_spec", docker__parse_port_spec(to_json({ spec => $spec })))
}

## Build a -p port spec from parts — inverse of parse_port_spec. %opts:
## container_port (required), host_port, host_ip (IPv6 literals auto-bracketed),
## protocol (default tcp; only emitted as /proto when not tcp). Returns the spec
## string under `spec`.
fn Docker::build_port_spec (%opts) {
    Docker::_decode("build_port_spec", docker__build_port_spec(to_json(\%opts)))->{spec}
}

## Parse a -v mount spec "src:dst[:opts]" into a hashref
## { type, source, target, readonly, options }. type is "bind" when source is a
## host path (/, ., ~), "volume" for a named source, "anonymous" for a lone dst.
## opts is the comma list after the second colon; "ro" sets readonly.
fn Docker::parse_mount ($spec) {
    Docker::_decode("parse_mount", docker__parse_mount(to_json({ spec => $spec })))
}

